# 复旦统一身份认证
fudan_username=your_student_id
fudan_password=your_password

# TOTP 动态口令密钥（可选，用于 MFA 增强认证全自动登录）
# 在 id.fudan.edu.cn 个人中心 → 安全设置 → 动态口令 中绑定并导出 base32 密钥
# fudan_otp_secret=YOUR_BASE32_OTP_SECRET

# 预约体育场馆时填写的手机号
# fudan_phone=13800000000

# 预约活动室时填写的专业代码（如 081200）
# fudan_major=081200

# 预约活动室时填写的邮箱
# fudan_email=your_email@fudan.edu.cn

# 预约活动室时填写的活动简介
# fudan_activity_desc=学习讨论

# 申请表扫描件路径（可选，不填则上传占位图片）
# fudan_application_file=/path/to/application.pdf

# Bark 推送（可选，用于手机通知）
# BARK_URL=https://api.day.app/your_bark_key

# SSE 模式鉴权 token（远端部署时建议设置，不设置则不启用鉴权）
# MCP_AUTH_TOKEN=your-secret-token

# ── 自动预约（automations/auto_book.py）─────────────────────────────────────
# 推荐：按名字选场馆（运行 `uv run python automations/venues.py` 查看完整列表）
# BOOK_VENUE_NAME=羽毛球-本部      # 场馆名称，自动填充 ID，无需手查

# 手动指定 ID（会覆盖 BOOK_VENUE_NAME 中的值）
# BOOK_VENUE_TYPE=sports          # sports（体育场馆）或 activity（活动室）
# BOOK_RESOURCE_ID=1119           # 父场馆 ID，必填
# BOOK_SUB_IDS=                   # 子场地 ID 列表，逗号分隔（留空自动选）

# 通用配置
# BOOK_PREFER_TIMES=18:00-20:00,20:00-22:00  # 期望时段，按顺序优先匹配
# BOOK_DATE_OFFSET=1              # 预约哪天（相对今天偏移天数，默认1=明天）
# BOOK_NUMBER=1                   # 预约人数

# 脉冲抢占配置
# BOOK_OPEN_TIME=07:00            # 预约窗口开放时刻（HH:MM）
# BOOK_PULSE_BEFORE=60            # 开放前多少秒开始发请求
# BOOK_PULSE_AFTER=60             # 开放后多少秒内继续发请求
# BOOK_PULSE_MAX=10               # 脉冲窗口内最多发多少次请求（成功即退出）
